---
/**
 * TaxBrain — Setup / Onboarding Page
 *
 * Shown to first-time visitors or when user wants to re-enter their profile.
 * Hosts the OnboardingWizard React island.
 */

import Layout from '../components/Layout.astro';
import OnboardingWizard from '../components/islands/OnboardingWizard';
---

<Layout title="Set Up Your Profile | TaxBrain">
  <noscript>
    <div class="card" style="margin-bottom: var(--space-6); padding: var(--space-6);">
      <h2>JavaScript Required</h2>
      <p>Please enable JavaScript to use the interactive onboarding wizard.</p>
    </div>
  </noscript>
  <OnboardingWizard client:load />
</Layout>
