---
import Layout from '../components/Layout.astro';
import Simulator from '../components/islands/Simulator';
---

<Layout title="Scenario Simulator | TaxBrain">
  <noscript>
    <div class="card" style="margin-bottom: var(--space-6); padding: var(--space-6);">
      <h2>JavaScript Required for Scenario Simulator</h2>
      <p>The scenario simulator requires JavaScript to render real-time interactive sliders and tax breakeven charts.</p>
    </div>
  </noscript>
  <Simulator client:load />
</Layout>

<style>
  /* Simulator two-column layout */
  .simulator-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 1024px) {
    .simulator-grid {
      grid-template-columns: 380px 1fr;
    }
  }

  .simulator-controls {
    display: flex;
    flex-direction: column;
  }

  .simulator-results {
    display: flex;
    flex-direction: column;
  }
</style>
